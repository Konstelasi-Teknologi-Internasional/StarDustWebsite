    "verify:narration": "tsc -p tsconfig.scripts.json && node .scenario-build/scripts/verify-narration.js",
    "verify:lifecycles": "tsc -p tsconfig.scripts.json && node .scenario-build/scripts/verify-lifecycles.js",
    "verify:tour": "tsc -p tsconfig.scripts.json && node .scenario-build/scripts/verify-tour.js"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2"
  }
}
